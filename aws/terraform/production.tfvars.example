# Optional local sizing file. Do not put passwords, API keys, or DATABASE_URL here.
aws_region           = "us-east-1"
project_name         = "reviewai"
environment          = "production"
container_port       = 8000
task_cpu             = 256
task_memory          = 512
desired_count        = 1
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
bedrock_model_id     = "anthropic.claude-3-haiku-20240307-v1:0"

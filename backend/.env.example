# Revive AI Backend Environment Configuration

# Database Configuration (Use Supabase free tier)
# Get from: https://supabase.com > Your Project > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# Redis Configuration (Use Upstash free tier)
# Get from: https://upstash.com > Your Database > Details > Redis URL
REDIS_URL=redis://default:YOUR_PASSWORD@xxx.upstash.io:6379

# Security (Generate a random 32+ character string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-min-32-chars

# JWT Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Revive AI

# CORS Settings (comma-separated)
ALLOWED_HOSTS=http://localhost:3000,http://localhost:8000

# LLM Provider Settings
# Get Mistral AI key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: OpenAI API key (if you want to use OpenAI instead)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Default LLM provider (openai uses Mistral if MISTRAL_API_KEY is set)
DEFAULT_LLM_PROVIDER=openai

# Background Task Configuration (same as REDIS_URL)
CELERY_BROKER_URL=redis://default:YOUR_PASSWORD@xxx.upstash.io:6379
CELERY_RESULT_BACKEND=redis://default:YOUR_PASSWORD@xxx.upstash.io:6379

# Development Settings
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: Email Configuration (for production)
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@revive-ai.com

# Optional: External Services
# WHATSAPP_API_KEY=your-whatsapp-api-key

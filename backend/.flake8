[flake8]
max-line-length = 88
extend-ignore = 
    E203,
    E501,
    W503,
    W504,
    F401

exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    migrations,
    alembic/versions,
    .pytest_cache,
    .hypothesis,
per-file-ignores = 
    __init__.py:F401
    tests/*:S101
max-complexity = 10
import-order-style = google
application-import-names = app
docstring-convention = google
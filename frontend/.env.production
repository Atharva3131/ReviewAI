# Production Environment Variables
# Copy this file and update with your production values

# Server-side destination for the Next.js same-origin API proxy.
BACKEND_API_URL=http://reviewai-staging-alb-2013043867.us-east-1.elb.amazonaws.com

# The browser uses /api/v1 through the same-origin proxy in production.
# NEXT_PUBLIC_API_URL is intentionally not set here.

# Demo Mode (set to false for production)
NEXT_PUBLIC_DEMO_MODE=false
